{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "pinDigests": true,
  "packageRules": [
    {
      "matchPackageNames": ["ghcr.io/hassio-addons/**", "lscr.io/linuxserver/**"],
      "groupName": "base images",
      "groupSlug": "base-images",
      "schedule": ["at any time"]
    },
    {
      "matchPackageNames": ["lscr.io/linuxserver/**"],
      "versioning": "loose"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)build\\.yaml$/"],
      "matchStrings": ["\\s+(?<arch>aarch64|amd64|armhf|armv7|i386):\\s+\"(?<depName>[^\"]+):(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "docker"
    }
  ]
}
